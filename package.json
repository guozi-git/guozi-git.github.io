{
  "name": "guozi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run papers:check && npm run data:generate && next build && node scripts/prepare-export.mjs && node scripts/check-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "test:compat": "playwright test -c playwright.compat.config.ts",
    "test:static": "node scripts/check-static.mjs",
    "content:check": "node scripts/check-content.mjs && node --test scripts/atelier-order.test.mjs scripts/factory-reviews.test.mjs scripts/research-reviews.test.mjs scripts/paper-label.test.mjs && npm run papers:check && npm run data:test",
    "papers:check": "node scripts/paper-maintenance.mjs --check",
    "papers:update": "node scripts/paper-maintenance.mjs",
    "papers:test": "node --test scripts/paper-maintenance.test.mjs",
    "data:generate": "node scripts/generate-paper-delivery.mjs",
    "data:test": "npm run data:generate && node --test scripts/paper-delivery.test.mjs scripts/idle-preload.test.mjs",
    "predev": "npm run data:generate",
    "pretypecheck": "npm run data:generate"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
